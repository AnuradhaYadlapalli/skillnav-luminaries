# Copy this file to `.env` and run: npm install && npm run dev

# --- Supabase (external project) ---
VITE_SUPABASE_URL=https://fbeglrxnxgkpjgimuikh.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_DR72ldi133LSXjzP1LG2bg_FXVlFKpr
# (VITE_SUPABASE_PUBLISHABLE_KEY is accepted as an alias for the line above)

# Optional — only needed for privileged server-side jobs (never sent to the browser).
# Supabase dashboard -> Project Settings -> API keys -> service_role
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# The server-side SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY / SUPABASE_PROJECT_ID
# values are derived automatically from the VITE_ ones above.

# --- AI (Google Gemini) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional override, defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Optional: dev server port (defaults to 8080)
# PORT=8080
